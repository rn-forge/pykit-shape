# BEGIN rn-forge kiln
; Generated by kiln 0.1.0 from .rn-forge/kiln/config.toml — do not edit inside this block; run 'kiln apply'.
; A contract of this repo's own goes below the END marker, as its own [importlinter:contract:<name>] section.
;
; The import boundary, in the half of it import-linter can enforce (see
; .rn-forge/kiln/standard.md, "The import boundary").
;
; The rule that rn-forge-commons and rn-forge-tooling are the *only* rn-forge
; packages a repo may depend on is NOT here, and cannot be: import-linter
; rejects subpackages of external packages, so `rn_forge.kiln` is not a legal
; forbidden module however the contract is written. That rule is enforced where
; it is actually decidable — at the dependency declaration, by
; `kiln doctor`'s rn-forge-deps rule.
;
; What is enforceable here is the other half of the reuse pattern: a package
; takes its console, CLI and templating surface *from the rn-forge library that
; owns it*, not by depending on the underlying third-party package itself. A
; direct `import typer` in product code is how two kits ended up with two Typer
; floors and two console conventions.
;
; A workspace gets a second contract: its packages are published separately, so
; a silent dependency between them is a release-ordering bug waiting to happen.

[importlinter]
root_packages =
    rn_forge.auth
    rn_forge.cli
    rn_forge.commons
    rn_forge.data
    rn_forge.devops
    rn_forge.django
    rn_forge.fastapi
    rn_forge.sqlalchemy
    rn_forge.tooling
    rn_forge.web
; None of the forbidden packages are installed here. grimp only reaches an
; external package when it is told to, and without this the contract would pass
; by never being evaluated at all.
include_external_packages = True

; This repository owns its import contracts: they are below the END marker.
# END rn-forge kiln

[importlinter:contract:commons-is-runtime-neutral]
name = rn_forge.commons never imports cli, tooling or Typer
type = forbidden
source_modules =
    rn_forge.commons
forbidden_modules =
    rn_forge.cli
    rn_forge.tooling
    typer
    click

[importlinter:contract:commons-core-has-no-extras]
name = commons' core imports neither generation, text, Jinja nor a Markdown parser
type = forbidden
# Sibling sources, never `rn_forge.commons` itself: import-linter does not
# break a forbidden contract whose forbidden module is inside its source.
source_modules =
    rn_forge.commons.config
    rn_forge.commons.exceptions
    rn_forge.commons.findings
    rn_forge.commons.fs
    rn_forge.commons.integration
    rn_forge.commons.lang
    rn_forge.commons.logging
    rn_forge.commons.runtime
    rn_forge.commons.testing
forbidden_modules =
    rn_forge.commons.generation
    rn_forge.commons.text
    jinja2
    markdown
    markdown_it

[importlinter:contract:generation-core-renders-nothing]
name = the generation engine imports no template engine; only generation.templated does
type = forbidden
source_modules =
    rn_forge.commons.generation.artifacts
    rn_forge.commons.generation.plan
    rn_forge.commons.generation.apply
forbidden_modules =
    rn_forge.commons.text
    jinja2

[importlinter:contract:cli-has-no-tooling]
name = rn_forge.cli never imports tooling or Jinja
type = forbidden
source_modules =
    rn_forge.cli
forbidden_modules =
    rn_forge.tooling
    jinja2

[importlinter:contract:library-layers]
name = tooling depends on cli, cli depends on commons, never the other way round
type = layers
layers =
    rn_forge.tooling
    rn_forge.cli
    rn_forge.commons

[importlinter:contract:django-runtime-has-no-tooling]
name = rn_forge.django's runtime surface never imports cli, tooling, Typer or Jinja
type = forbidden
source_modules =
    rn_forge.django
forbidden_modules =
    rn_forge.cli
    rn_forge.tooling
    typer
    jinja2
# `rn_forge.django.codegen` is the one place the extra may be imported from.
# It does not exist yet (the standardization plan defers generators), so an
# unmatched exemption is not an error here — the contract still holds today.
ignore_imports =
    rn_forge.django.codegen -> *
    rn_forge.django.codegen.* -> *
unmatched_ignore_imports_alerting = none

[importlinter:contract:fastapi-runtime-has-no-tooling]
name = rn_forge.fastapi never imports django, cli, tooling or Jinja
type = forbidden
source_modules =
    rn_forge.fastapi
forbidden_modules =
    rn_forge.django
    rn_forge.cli
    rn_forge.tooling
    jinja2
# Written while `rn_forge.fastapi.codegen` is empty, for the same reason as
# django's: a fence added after the first generator was never tested.
ignore_imports =
    rn_forge.fastapi.codegen -> *
    rn_forge.fastapi.codegen.* -> *
unmatched_ignore_imports_alerting = none

[importlinter:contract:web-is-framework-free]
name = rn_forge.web never imports a web framework, cli or tooling
type = forbidden
source_modules =
    rn_forge.web
forbidden_modules =
    django
    fastapi
    starlette
    rest_framework
    rn_forge.cli
    rn_forge.tooling

[importlinter:contract:web-layers]
name = django, fastapi and sqlalchemy depend on auth, auth on web, web and data on commons, never the other way round
type = layers
# The `:` makes django, fastapi and sqlalchemy independent siblings at one
# layer: none may import another. web and data are likewise independent
# siblings over commons; auth sits between them and web.
layers =
    rn_forge.django : rn_forge.fastapi : rn_forge.sqlalchemy
    rn_forge.auth
    rn_forge.web : rn_forge.data
    rn_forge.commons

[importlinter:contract:sqlalchemy-is-framework-free]
name = rn_forge.sqlalchemy never imports fastapi, django or their packages
type = forbidden
source_modules =
    rn_forge.sqlalchemy
forbidden_modules =
    rn_forge.fastapi
    rn_forge.django
    fastapi
    starlette
    django
    rest_framework

[importlinter:contract:devops-has-no-rn-forge-dependency]
name = rn_forge.devops never imports another rn_forge package
type = forbidden
source_modules =
    rn_forge.devops
forbidden_modules =
    rn_forge.commons
    rn_forge.cli
    rn_forge.tooling
    rn_forge.django
    rn_forge.fastapi
    rn_forge.web
    rn_forge.sqlalchemy

[importlinter:contract:devops-core-has-no-adapter]
name = rn_forge.devops.ci, .index, .notes and .requirements never import the uv, GitHub or releases adapters
type = forbidden
source_modules =
    rn_forge.devops.ci
    rn_forge.devops.index
    rn_forge.devops.notes
    rn_forge.devops.requirements
forbidden_modules =
    rn_forge.devops.uv
    rn_forge.devops.github
    rn_forge.devops.releases

[importlinter:contract:devops-requirements-is-standalone]
name = rn_forge.devops.requirements, .index, .notes and .releases never import the planner
type = forbidden
source_modules =
    rn_forge.devops.requirements
    rn_forge.devops.index
    rn_forge.devops.notes
    rn_forge.devops.releases
forbidden_modules =
    rn_forge.devops.ci
    rn_forge.devops.uv
    rn_forge.devops.github

[importlinter:contract:data-core-has-no-adapter]
name = rn_forge.data's core modules never import the pandas adapter
type = forbidden
source_modules =
    rn_forge.data.excel
forbidden_modules =
    rn_forge.data.pandas

[importlinter:contract:auth-core-has-no-adapter]
name = rn_forge.auth's core never imports its adapters
type = forbidden
source_modules =
    rn_forge.auth
forbidden_modules =
    rn_forge.auth.oidc
    rn_forge.auth.redis
    rn_forge.auth.testing
